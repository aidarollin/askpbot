{
  "name": "askpbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "eval:offline": "tsx evals/run.ts --offline",
